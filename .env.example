# Copie ce fichier en `.env` puis remplis les valeurs.
# Toute variable laissée vide n'est PAS envoyée à l'API (valeur par défaut du modèle).

# --- Connexion --------------------------------------------------------------
OPENAI_API_KEY=sk-...
# Facultatif : point d'entrée alternatif (Azure, OpenRouter, Ollama, proxy...)
OPENAI_BASE_URL=
OPENAI_ORG_ID=
# Timeout en secondes et nombre de retries du client
OPENAI_TIMEOUT=60
OPENAI_MAX_RETRIES=2

# --- Modèle et échantillonnage ---------------------------------------------
OPENAI_MODEL=gpt-5.4-mini
# Laisser vide pour les modèles de raisonnement qui refusent ces paramètres.
OPENAI_TEMPERATURE=0.3
OPENAI_TOP_P=
OPENAI_PRESENCE_PENALTY=
OPENAI_FREQUENCY_PENALTY=
OPENAI_MAX_TOKENS=1500
# Fixer une graine rend les réponses plus reproductibles (best effort)
OPENAI_SEED=

# --- Comportement du script -------------------------------------------------
# Prompt à améliorer, si non fourni en argument CLI ni via stdin.
PE_INPUT_PROMPT=écris un texte sur les chiens
# Alternative : chemin d'un fichier contenant le prompt (prioritaire sur PE_INPUT_PROMPT)
PE_INPUT_FILE=
# Où sauvegarder le résultat (vide = affichage console uniquement)
PE_OUTPUT_FILE=
# Affichage en flux (true) ou réponse d'un bloc (false)
PE_STREAM=true

# --- Réglage du méta-prompt -------------------------------------------------
# Remplacer entièrement le méta-prompt intégré (texte inline, ou fichier)
PE_SYSTEM_PROMPT=
PE_SYSTEM_PROMPT_FILE=
# Consignes ajoutées au méta-prompt intégré
PE_TARGET_MODEL=
PE_TECHNIQUES=
PE_LANGUAGE=français
